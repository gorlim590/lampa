+    // One coalesced full snapshot for the active launch; six bounded attempts.
+    // JavaScript acknowledges only a matching live account/profile/handoff.
+    private fun deliverPendingJustPlusRaw(resetBudget: Boolean = false) {
+        val pending = pendingRawDelivery ?: return
+        if (pending.session != justPlusNativeSessionId) { pendingRawDelivery = null; return }
+        if (resetBudget) pending.attempts = 0
+        if (rawDeliveryBusy || !browserInitComplete || !loaderView.isGone ||
+            (!lifecycle.currentState.isAtLeast(Lifecycle.State.RESUMED) && !keepPlayerConnection)) return
+        if (pending.attempts >= 6) return
+        rawDeliveryJob?.cancel()
+        rawDeliveryBusy = true
+        pending.attempts++
+        browser?.evaluateJavascript(pending.js) { result ->
+            rawDeliveryBusy = false
+
+            if (pendingRawDelivery !== pending) { deliverPendingJustPlusRaw(); return@evaluateJavascript }
+            if (result == "true") { pendingRawDelivery = null; return@evaluateJavascript }
+            if (pending.attempts < 6) rawDeliveryJob = lifecycleScope.launch {
+                delay((1000L shl (pending.attempts - 1)).coerceAtMost(16000L))
+                deliverPendingJustPlusRaw()
+            }
+        }
+    }
