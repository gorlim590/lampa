+    /** Sends raw, measured Just+ item progress to JS without logging or persisting it in Timeline. */
+    private fun emitJustPlusMeasuredReport(
+        report: JSONObject,
+        state: PlayerStateManager.PlaybackState,
+        card: LampaCard?
+    ) {
+        val positions = report.optJSONArray("positions") ?: return
+        val durations = report.optJSONArray("durations") ?: return
+        val hasVisits = report.optJSONArray("has_visits") ?: return
+        if (positions.length() != state.playlist.size || durations.length() != state.playlist.size || hasVisits.length() != state.playlist.size) return
+
+        val items = JSONArray()
+        state.playlist.forEachIndexed { index, item ->
+            val hash = item.timeline?.hash?.takeIf { it.isNotEmpty() && it != "0" } ?: return@forEachIndexed
+            val position = positions.optInt(index, -1)
+            val duration = durations.optInt(index, -1)
+            if (!hasVisits.optBoolean(index, false) || position < 0 || duration <= 0) return@forEachIndexed
+            items.put(JSONObject().apply {
+                put("index", index)
+                put("hash", hash)
+                put("season", item.season ?: JSONObject.NULL)
+                put("episode", item.episode ?: JSONObject.NULL)
+                put("position_sec", position)
+                put("duration_sec", duration)
+                put("has_visit", true)
+            })
+        }
+        if (items.length() == 0) return
+        val payload = JSONObject().apply {
+            put("version", 1)
+            put("card_id", card?.tmdb_id?.takeIf { it.isNotEmpty() } ?: card?.id)
+            put("end_by", report.optString("end_by"))
+            put("items", items)
+        }
+        val quoted = JSONObject.quote(payload.toString())
+        val js = "(function(){try{var p=JSON.parse($quoted);if(window.dispatchEvent&&window.CustomEvent)window.dispatchEvent(new CustomEvent('lampa:justplus-raw-report',{detail:p}));}catch(e){}})();"
+        if (browserInitComplete && loaderView.isGone) browser?.evaluateJavascript(js, null)
+    }
+
