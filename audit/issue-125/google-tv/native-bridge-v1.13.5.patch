+        state: PlayerStateManager.PlaybackState,
+        card: LampaCard?
+    ) {
+        val sessionId = report.optString("session_id")
+        if (sessionId.isEmpty() || sessionId != justPlusNativeSessionId) return
+        val descriptor = justPlusSessionDescriptor ?: return
+        val visits = report.optJSONArray("measured_visits") ?: return
+        val items = JSONArray()
+        // Every actual visit matters: restarting A can reset positions[A] to zero
+        // after an earlier eligible visit. Never derive maximum progress from the latest position.
+        for (v in maxOf(0, visits.length() - 500) until visits.length()) {
+            val visit = visits.optJSONObject(v) ?: continue
+            val index = visit.optInt("index", -1)
+            val item = state.playlist.getOrNull(index) ?: continue
+            val hash = item.timeline?.hash?.takeIf { it.isNotEmpty() && it != "0" } ?: continue
+            val position = visit.optInt("position_sec", -1)
+            val duration = visit.optInt("duration_sec", -1)
+            if (position < 0 || duration <= 0) continue
+            items.put(JSONObject().apply {
+                put("index", index); put("hash", hash)
+                put("season", item.season ?: JSONObject.NULL)
+                put("episode", item.episode ?: JSONObject.NULL)
+                put("position_sec", position); put("duration_sec", duration)
+                put("has_visit", true)
+            })
+        }
+        if (items.length() == 0) return
+        val payload = JSONObject().apply {
