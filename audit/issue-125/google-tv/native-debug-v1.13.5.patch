+        val js = "(function(){try{var d=JSON.parse($descriptorQuoted),p=JSON.parse($quoted);if(window.dispatchEvent&&window.CustomEvent){window.dispatchEvent(new CustomEvent('lampa:justplus-session',{detail:d}));window.dispatchEvent(new CustomEvent('lampa:justplus-raw-report',{detail:p}));return p.__lampa_trakt_ack===true;}}catch(e){}})();"
+        traceIssue125("raw-queued", report)
+        pendingRawDelivery = RawDelivery(sessionId, js)
+        deliverPendingJustPlusRaw()
+    }
